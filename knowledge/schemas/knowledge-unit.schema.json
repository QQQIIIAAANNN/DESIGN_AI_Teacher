{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/QQQIIIAAANNN/DESIGN_AI_Teacher/knowledge/schemas/knowledge-unit.schema.json",
  "title": "DESIGN_AI_Teacher Knowledge Unit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "knowledge_id",
    "source_id",
    "source_type",
    "source_title",
    "exam_type",
    "topics",
    "unit_role",
    "evaluation_layer",
    "knowledge_type",
    "statement",
    "conditions",
    "exceptions",
    "evidence_targets",
    "severity_hint",
    "reasoning",
    "remediation",
    "image_refs",
    "quote_or_paraphrase",
    "curation_status"
  ],
  "properties": {
    "knowledge_id": { "type": "string", "minLength": 1 },
    "source_id": { "type": "string", "minLength": 1 },
    "source_type": {
      "type": "string",
      "enum": [
        "platform_policy",
        "teacher_pdf",
        "teacher_notes",
        "critique_record",
        "exam_prompt",
        "code",
        "case_study",
        "other"
      ]
    },
    "source_title": { "type": "string", "minLength": 1 },
    "page": { "type": ["integer", "null"], "minimum": 1 },
    "source_section": { "type": ["string", "null"] },
    "exam_type": {
      "type": "string",
      "enum": ["design", "site_planning", "both"]
    },
    "topics": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "unit_role": {
      "type": "string",
      "enum": ["evaluation_rule", "review_policy", "repair_strategy", "precedent"]
    },
    "evaluation_layer": {
      "type": ["string", "null"],
      "enum": ["gatekeeper", "core_quality", "polish", null]
    },
    "knowledge_type": {
      "type": "string",
      "enum": [
        "hard_rule",
        "soft_rule",
        "heuristic",
        "anti_pattern",
        "repair_pattern",
        "precedent",
        "preference"
      ]
    },
    "statement": { "type": "string", "minLength": 1 },
    "conditions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "exceptions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "evidence_targets": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "severity_hint": {
      "type": "string",
      "enum": ["high", "medium", "low", "none"]
    },
    "reasoning": { "type": "string", "minLength": 1 },
    "bad_pattern": { "type": ["string", "null"] },
    "good_pattern": { "type": ["string", "null"] },
    "remediation": {
      "type": "array",
      "items": { "type": "string" }
    },
    "image_refs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "quote_or_paraphrase": {
      "type": "string",
      "enum": ["quote", "paraphrase", "platform_rule"]
    },
    "curation_status": {
      "type": "string",
      "enum": ["raw", "extracted", "reviewed", "canonical"]
    }
  }
}
