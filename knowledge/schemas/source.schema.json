{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/QQQIIIAAANNN/DESIGN_AI_Teacher/knowledge/schemas/source.schema.json",
  "title": "DESIGN_AI_Teacher Source Manifest Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_id",
    "filename",
    "title",
    "source_type",
    "exam_type",
    "has_images",
    "rights_note",
    "processing_status"
  ],
  "properties": {
    "source_id": { "type": "string", "minLength": 1 },
    "filename": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "source_type": {
      "type": "string",
      "enum": [
        "platform_policy",
        "teacher_pdf",
        "teacher_notes",
        "critique_record",
        "exam_prompt",
        "code",
        "case_study",
        "other"
      ]
    },
    "teacher": { "type": ["string", "null"] },
    "year": { "type": ["integer", "null"], "minimum": 1900 },
    "exam_type": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "enum": ["design", "site_planning"] }
    },
    "page_count": { "type": ["integer", "null"], "minimum": 1 },
    "has_images": { "type": "boolean" },
    "rights_note": { "type": "string", "minLength": 1 },
    "content_hash": { "type": ["string", "null"] },
    "storage_ref": { "type": ["string", "null"] },
    "processing_status": {
      "type": "string",
      "enum": ["inventory", "deduplicated", "extracting", "reviewed", "canonical", "blocked"]
    }
  }
}
