# 本機開發用；複製成 .env.local 後依需要調整。
# 審圖透過本機 Next.js 後端連 CLIProxyAPI；API key 不會送到瀏覽器。
NEXT_PUBLIC_CLIPROXY_MANAGEMENT_URL=http://127.0.0.1:8317
CLIPROXY_URL=http://127.0.0.1:8317
# 若 config.yaml 的 api-keys 已有有效項目，可留空並由後端讀取；勿加 NEXT_PUBLIC_ 前綴。
CLIPROXY_API_KEY=
CLIPROXY_AUTO_START=1
REVIEW_PROVIDER=cliproxy
# 題目 PDF 讀取工具不在 PATH 時，填入 Poppler 的 bin 資料夾。
# POPPLER_BIN_DIR=C:\path\to\poppler\Library\bin

# 所有相對路徑都以專案根目錄為基準；原始教材留在雲端硬碟，不進 Git。
KNOWLEDGE_SOURCE_DIR=../K圖會
PRIVATE_KNOWLEDGE_INDEX=knowledge/private/index.jsonl
REVIEW_MEMORY_FILE=knowledge/private/core-memory/review-feedback.md
